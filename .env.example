# Local development only. Never commit .env or use it for isolated release checks.
# Production receives runtime values from the service manager/secret store.
DATABASE_URL="postgresql://campusforge:campusforge@localhost:5432/campusforge"
# Auth.js supports legacy NEXTAUTH_* aliases. AUTH_* wins when both are set.
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Enable only behind a trusted ingress that overwrites Host/X-Forwarded-*.
AUTH_TRUST_HOST="true"
# Default shared source budget. Enable IP identity ONLY when ingress overwrites this
# single-IP header and the Node origin cannot be reached directly. X-Forwarded-For is ignored.
AUTH_RATE_LIMIT_TRUST_PROXY="false"
AUTH_RATE_LIMIT_IP_HEADER="x-campusforge-client-ip"
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="campusforge"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
# API key is worker-only. OPENAI_MODEL and AI policy must match web/worker.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Conservative UTF-8 byte token upper bound; oversized input is rejected, not truncated.
AI_MAX_INPUT_TOKENS="16000"
AI_MAX_OUTPUT_TOKENS="2048"
AI_MAX_ATTEMPTS="3"
AI_OPERATION_TIMEOUT_MS="120000"
AI_REQUEST_TIMEOUT_MS="30000"
AI_CONNECTION_TIMEOUT_MS="5000"
AI_LEASE_MS="60000"
# Lifetime workspace estimate: $1; per-operation reservation ceiling: $0.10.
# Unknown outcomes retain reservations until reviewed reconciliation.
AI_WORKSPACE_BUDGET_MICROS="1000000"
AI_OPERATION_BUDGET_MICROS="100000"
AI_WORKSPACE_CONCURRENCY="2"
AI_ATTEMPT_RETENTION_DAYS="90"
AI_CLEANUP_BATCH_SIZE="100"
# Optional build-time public URL. Rebuild web when changing this value.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
