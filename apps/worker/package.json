{
  "name": "@campusforge/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node scripts/start.mjs",
    "build": "tsc -p tsconfig.build.json",
    "env:probe": "node ../../scripts/probe-env.mjs worker",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint src tests scripts --max-warnings 0"
  },
  "dependencies": {
    "@campusforge/db": "workspace:*",
    "@campusforge/shared": "workspace:*",
    "@campusforge/ai": "workspace:*",
    "@aws-sdk/client-s3": "3.1146.0",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "scripts"
  ]
}
