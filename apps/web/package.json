{
  "name": "@campusforge/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "env:probe": "node ../../scripts/probe-env.mjs web",
    "test": "node --test tests/*.test.mjs && playwright test --config ../../playwright.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint src scripts tests --max-warnings 0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@campusforge/db": "workspace:*",
    "@campusforge/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1146.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "5.104.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ioredis": "5.11.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "dotenv-cli": "^11.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
